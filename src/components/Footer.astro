---
// Evaluated at build time, so a redeploy keeps this current without an edit.
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="suite suite--flagship">
    <div class="footer__top">
      <div>
        <span class="footer__line">Evidence-governed infrastructure.</span>
        <address class="footer__address">326 Delaware Street, Johnson City, TN 37604<br />
          <a href="tel:+17473221977">(747) 322-1977</a> &middot; <a href="mailto:info@intellmeai.com">info@intellmeai.com</a></address>
        <p class="caption" style="margin-top:10px">InTellMe is the trade name of a sole proprietorship owned and operated by Michael Brandon Lane.</p>
      </div>
      <nav aria-label="Footer">
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px 26px">
          <li><a class="footer__nav-link" href="/#technology">Technology</a></li>
          <li><a class="footer__nav-link" href="/#products">Products</a></li>
          <li><a class="footer__nav-link" href="/#research">Research</a></li>
          <li><a class="footer__nav-link" href="/#company">Company</a></li>
          <li><a class="footer__nav-link" href="/investors">Investors</a></li>
          <li><a class="footer__nav-link" href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer__legal">
      <span>&copy; {year} InTellMe</span>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/refunds">Refunds</a>
      <a href="mailto:info@intellmeai.com">info@intellmeai.com</a>
      <a href="mailto:security@intellmeai.com">security@intellmeai.com</a>
      <a href="/accessibility">Accessibility</a>
      <a href="https://github.com/GooseyPrime" rel="noopener">GitHub</a>
    </div>
  </div>
</footer>
