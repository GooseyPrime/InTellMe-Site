---
import Base from '../layouts/Base.astro';
---
<Base title="Request received — InTellMe" description="Your request has been received." path="/investor-request-received" noindex={true}>
  <section class="room" style="min-height:70svh;display:flex;align-items:center">
    <div class="suite">
      <p class="kicker">Investor overview</p>
      <h1 class="suite-title" style="max-width:24ch">Received. Materials are sent after review.</h1>
      <hr class="rule--champagne" style="margin-top:32px" />
      <p style="margin-top:28px;max-width:52ch">If anything is time-sensitive, write directly to <a href="mailto:brandon@intellmeai.com">brandon@intellmeai.com</a>.</p>
      <div class="actions" style="margin-top:36px">
        <a class="btn btn--secondary" href="/investors">Back to the overview</a>
      </div>
    </div>
  </section>
</Base>
